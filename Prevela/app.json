{
  "expo": {
		"ios": {
			"bundleIdentifier": "com.prevela.firebase",
			"googleServicesFile": "/workspaces/prevela-reactnative-expo/Prevela/GoogleService-Info.plist"
		},
		"android": {
			"package": "com.prevela.firebase",
			"googleServicesFile": "./google-services.json"
		},
    "name": "Prevela",
    "slug": "Prevela",
    "version": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "b9141ff1-b49e-4238-bfc7-c5991a078140"
      }
    },
    "owner": "prevela",
    "plugins": [
			"expo-router",
			[
				"expo-build-properties",
				{
					"ios": {
						"useFrameworks": "static"
					}
				}
			],
			"@react-native-firebase/app",
			"@react-native-firebase/auth"
		]
  }
}
